PORT=5001

# Render can provide this from the managed PostgreSQL database.
# If DATABASE_URL is set, the DB_* values below are not required.
DATABASE_URL=postgresql://user:password@host:5432/verixa
DB_SSL=false

DB_HOST=localhost
DB_PORT=5433
DB_NAME=verixa
DB_USER=postgres
DB_PASSWORD=your_password_here

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1h
GOOGLE_CLIENT_ID=your_google_oauth_web_client_id_here

SEPOLIA_RPC_URL=your_sepolia_rpc_url_here
BLOCKCHAIN_PRIVATE_KEY=your_blockchain_wallet_private_key_here
VERIXA_CONTRACT_ADDRESS=your_deployed_contract_address_here

PUBLIC_FRONTEND_URL=http://localhost:5173

# Email delivery. In production (Render free tier), SMTP ports are blocked,
# so set RESEND_API_KEY and the app sends over the Resend HTTPS API instead.
# Get a key at https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_sender_gmail@gmail.com
# Gmail App Password, not your normal Gmail password.
SMTP_PASS=your_gmail_app_password_here
# Keep this exactly in the form: Display Name <sender@gmail.com>
# With Resend free (no verified domain), use: EMAIL_FROM="Verixa <onboarding@resend.dev>"
EMAIL_FROM="Verixa <your_sender_gmail@gmail.com>"

# Set true only when SEPOLIA_RPC_URL, BLOCKCHAIN_PRIVATE_KEY, and VERIXA_CONTRACT_ADDRESS are configured.
BLOCKCHAIN_ENABLED=false
